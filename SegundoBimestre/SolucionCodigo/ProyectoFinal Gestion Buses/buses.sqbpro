</table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="119"/><column index="2" value="40"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE IF NOT EXISTS buses_urbanos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    numero INTEGER NOT NULL,
    ruta TEXT NOT NULL,
    hora_salida TEXT NOT NULL,
    veces_presentado INTEGER DEFAULT 0
);

CREATE TABLE IF NOT EXISTS buses_interurbanos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    numero INTEGER NOT NULL,
    ruta TEXT NOT NULL,
    hora_salida TEXT NOT NULL,
    veces_presentado INTEGER DEFAULT 0
);
